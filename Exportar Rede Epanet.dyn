    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Carregar as bibliotecas DesignScript e padrão do Python\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nparam_name = IN[1]\r\nprefix = 'T'\r\n\r\nfor index,element in enumerate(IN[0]):\r\n    element.SetParameterByName(param_name,prefix+str(index+1))\r\n    \r\nOUT = IN[0]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "8b7d32312c3a4e39ab6a7ccd66e2fd95",
      "Inputs": [
        {
          "Id": "2822461c6d4243c58ca8539ff7ebfb50",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2864a1db7d514af2acf1e1b8ba16f4a4",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "94b352f096544046ab85ce8d8580df45",
          "Name": "OUT",
          "Description": "Resultado do script Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Executa um script Python incorporado."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Obtém o documento ativo\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ndef verifica_colisao(elemento1, elemento2):\r\n    \"\"\"\r\n    Verifica se dois elementos colidem no Revit usando Dynamo.\r\n    \r\n    Args:\r\n        elemento1: Primeiro elemento do Revit.\r\n        elemento2: Segundo elemento do Revit.\r\n        \r\n    Returns:\r\n        True se houver colisão, False caso contrário.\r\n    \"\"\"\r\n    opt = Options()  # Opções para obter a geometria\r\n    geo1 = elemento1.get_Geometry(opt)\r\n    geo2 = elemento2.get_Geometry(opt)\r\n\r\n    # Converter a geometria em sólidos\r\n    solidos1 = [g for g in geo1 if isinstance(g, Solid) and g.Volume > 0]\r\n    solidos2 = [g for g in geo2 if isinstance(g, Solid) and g.Volume > 0]\r\n\r\n    # Verificar interseção entre os sólidos\r\n    for s1 in solidos1:\r\n        for s2 in solidos2:\r\n            if BooleanOperationsUtils.ExecuteBooleanOperation(s1, s2, BooleanOperationsType.Intersect).Volume > 0:\r\n                return True  # Colisão detectada\r\n\r\n    # Se não encontrou sólidos, verificar interseção da Bounding Box\r\n    bbox1 = elemento1.get_BoundingBox(None)\r\n    bbox2 = elemento2.get_BoundingBox(None)\r\n\r\n    if bbox1 and bbox2:\r\n        min1, max1 = bbox1.Min, bbox1.Max\r\n        min2, max2 = bbox2.Min, bbox2.Max\r\n        \r\n        # Teste de interseção das Bounding Boxes\r\n        if (min1.X <= max2.X and max1.X >= min2.X and\r\n            min1.Y <= max2.Y and max1.Y >= min2.Y and\r\n            min1.Z <= max2.Z and max1.Z >= min2.Z):\r\n            return True  # Colisão detectada na Bounding Box\r\n\r\n    return False  # Sem colisão\r\n\r\n\r\ndef mapear_colisoes(pecas, tubos):\r\n    \"\"\"\r\n    Mapeia tubos para as peças que colidem com eles, usando o ID real de cada elemento como identificador.\r\n\r\n    Args:\r\n        pecas (list): Lista de peças do Revit.\r\n        tubos (list): Lista de tubos do Revit.\r\n\r\n    Returns:\r\n        dict: Dicionário onde cada chave é o ID de um tubo e o valor é uma lista \r\n              com os IDs das peças que colidem com ele (máximo de 2).\r\n    \"\"\"\r\n    colisoes = {}\r\n\r\n    for tubo in tubos:\r\n        pecas_colidindo = []\r\n\r\n        # Obtém o ID do tubo\r\n        id_tubo = str(tubo.Id.IntegerValue)\r\n\r\n        for peca in pecas:\r\n            if verifica_colisao(peca, tubo):\r\n                # Obtém o ID da peça\r\n                id_peca = str(peca.Id.IntegerValue)\r\n                pecas_colidindo.append(id_peca)\r\n\r\n            # Se já tem duas peças colidindo, paramos a verificação para esse tubo\r\n            if len(pecas_colidindo) == 2:\r\n                break\r\n\r\n        # Adiciona ao dicionário apenas se houver pelo menos uma colisão\r\n        if pecas_colidindo:\r\n            colisoes[id_tubo] = pecas_colidindo\r\n\r\n    return colisoes\r\n\r\n\r\n\r\n# Entrada do Dynamo (listas de elementos do Revit)\r\npecas = [UnwrapElement(e) for e in IN[0]]\r\ntubos = [UnwrapElement(e) for e in IN[1]]\r\n\r\n# Saída do Dynamo\r\nOUT = mapear_colisoes(pecas, tubos)\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "114186702f9c4c40a20a5b401e29a955",
      "Inputs": [
        {
          "Id": "8e67c8fe608d4172806bc8026d8acc40",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "dc1f8caaaadc4894a133d11d88c7ee83",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [

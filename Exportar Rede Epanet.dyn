    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\n\r\ntemplate = IN[0]\r\nmap_pipes = IN[1]\r\nnodes = IN[2]\r\n\r\ndef generate_list_node_with_elevation(nodes):\r\n    \"\"\"\r\n    Gera uma string formatada com as informações de elevação e rugosidade das peças.\r\n\r\n    FD_Código_de_Legenda    Elevation(Y)   FD_Vazão\r\n     N60             \t35.4000     \t0.14        \t                \t;\r\n\r\n    Args:\r\n        nodes (list): Lista de peças hidrossanitárias (elementos do Dynamo).\r\n\r\n    Returns:\r\n        str: String formatada com os dados das peças.\r\n    \"\"\"\r\n    linhas = []\r\n    fator_conversao = 0.3048  # Conversão de pés para metros\r\n\r\n    for node in nodes:\r\n        elemento = UnwrapElement(node)  # Desembrulha o elemento do Dynamo\r\n\r\n        # Obtém os parâmetros da peça\r\n        codigo_legenda = elemento.LookupParameter(\"FD_Código_de_Legenda\").AsString()\r\n        vazao = elemento.LookupParameter(\"FD_Vazão\").AsDouble()\r\n\r\n        # Obtém a elevação a partir da coordenada Z do Location\r\n        location = elemento.Location\r\n        if isinstance(location, LocationPoint):\r\n            elevacao = location.Point.Z * fator_conversao  # Convertendo para metros\r\n        else:\r\n            continue  # Se não tiver LocationPoint, ignora o elemento\r\n\r\n        # Formata os valores para garantir alinhamento e espaçamento correto\r\n        linha_formatada = \"{:<20}\\t{:<10.4f}\\t{:<10.2f}\\t\\t\\t;\".format(\r\n            codigo_legenda, elevacao, vazao\r\n        )\r\n\r\n        linhas.append(linha_formatada)\r\n\r\n    return \"\\n\".join(linhas)\r\n\r\n\r\ndef generate_list_pipes(map_pipes):\r\n    \"\"\"\r\n    Gera uma string formatada com as informações dos tubos e suas conexões.\r\n\r\n    FD_Código_de_Legenda    Node1   Node2   Comprimento  Diâmetro interno  FD_Rugosidade\r\n     T3              \tN46             \tN60             \t26.7093     \t100         \t140         \t0.0000      \tOpen  \t;\r\n\r\n    Args:\r\n        map_pipes (dict): Dicionário onde as chaves são IDs de tubos (string)\r\n                          e os valores são listas com os IDs das peças conectadas.\r\n\r\n    Returns:\r\n        str: String formatada com os dados dos tubos.\r\n    \"\"\"\r\n    doc = DocumentManager.Instance.CurrentDBDocument\r\n    linhas = []\r\n    fator_conversao = 0.3048  # Conversão de pés para metros\r\n\r\n    for tubo_id, pecas_ids in map_pipes.items():\r\n        elemento_tubo = doc.GetElement(ElementId(int(tubo_id)))  # Obtém o tubo pelo ID\r\n\r\n        # Verifica se o elemento foi encontrado\r\n        if not elemento_tubo:\r\n            continue\r\n\r\n        # Obtém o FD_Código_de_Legenda do tubo\r\n        codigo_tubo = elemento_tubo.LookupParameter(\"FD_Código_de_Legenda\").AsString()\r\n\r\n        # Obtém os FD_Código_de_Legenda das peças conectadas\r\n        codigo_pecas = []\r\n        for peca_id in pecas_ids:\r\n            elemento_peca = doc.GetElement(ElementId(int(peca_id)))\r\n\r\n            # Verifica se o elemento foi encontrado\r\n            if not elemento_peca:\r\n                continue\r\n\r\n            codigo_legenda_peca = elemento_peca.LookupParameter(\"FD_Código_de_Legenda\").AsString()\r\n            codigo_pecas.append(codigo_legenda_peca)\r\n\r\n        # Se não houver exatamente 2 peças conectadas, ignoramos o tubo\r\n        if len(codigo_pecas) != 2:\r\n            continue\r\n\r\n        # Obtém os valores usando BuiltInParameters\r\n        comprimento = elemento_tubo.get_Parameter(BuiltInParameter.CURVE_ELEM_LENGTH).AsDouble() * fator_conversao  # Unidade segue a do modelo\r\n        diametro = elemento_tubo.get_Parameter(BuiltInParameter.RBS_PIPE_DIAMETER_PARAM).AsDouble()  # Em unidades do modelo\r\n        \r\n        # Obtém o tipo do tubo e busca o FD_Rugosidade\r\n        tipo_tubo = doc.GetElement(elemento_tubo.GetTypeId())  # Obtém o ElementType do tubo\r\n        rugosidade = tipo_tubo.LookupParameter(\"FD_Rugosidade\").AsDouble()\r\n\r\n        # Formata a linha com os dados do tubo\r\n        linha_formatada = \"{:<20}\\t{:<10}\\t{:<10}\\t{:<10.4f}\\t{:<10.0f}\\t{:<10.0f}\\t{:<10.4f}\\tOpen  \t;\".format(\r\n            codigo_tubo, codigo_pecas[0], codigo_pecas[1], comprimento, diametro, rugosidade, 0.0000\r\n        )\r\n\r\n        linhas.append(linha_formatada)\r\n\r\n    return \"\\n\".join(linhas)\r\n\r\n\r\ndef generate_list_node_whit_coord(nodes):\r\n    \"\"\"\r\n    Gera uma string formatada com os nós e suas coordenadas X e Y convertidas para metros.\r\n\r\n    ;Node            \tX-Coord         \tY-Coord\r\n     N60             \t567205.58       \t9560387.76      \r\n\r\n    Args:\r\n        nodes (list): Lista de peças hidrossanitárias.\r\n\r\n    Returns:\r\n        str: String formatada com os dados dos nós.\r\n    \"\"\"\r\n    doc = DocumentManager.Instance.CurrentDBDocument\r\n    fator_conversao = 0.3048  # Conversão de pés para metros\r\n    linhas = []\r\n\r\n    for node in nodes:\r\n        elemento = UnwrapElement(node)  # Desembrulha o elemento do Dynamo\r\n\r\n        # Obtém os parâmetros da peça\r\n        codigo_legenda = elemento.LookupParameter(\"FD_Código_de_Legenda\").AsString()\r\n\r\n        # Obtém a posição da peça\r\n        location = elemento.Location\r\n        if isinstance(location, LocationPoint):\r\n            x_coord = location.Point.X * fator_conversao  # Convertendo para metros\r\n            y_coord = location.Point.Y * fator_conversao  # Convertendo para metros\r\n        else:\r\n            continue  # Se não tiver LocationPoint, ignora o elemento\r\n\r\n        # Formata a linha mantendo alinhamento e espaçamentos corretos\r\n        linha_formatada = \"{:<20}\\t{:<15.2f}\\t{:<15.2f}\".format(\r\n            codigo_legenda, x_coord, y_coord\r\n        )\r\n\r\n        linhas.append(linha_formatada)\r\n\r\n    return \"\\n\".join(linhas)\r\n    \r\n\r\ndef generate_document(template, nodes, map_pipes):\r\n    \"\"\"\r\n    Substitui os placeholders no template pelos dados gerados das peças e tubos.\r\n\r\n    Args:\r\n        template (str): Template base do documento.\r\n        nodes (list): Lista de peças hidrossanitárias.\r\n        map_pipes (dict): Dicionário de tubos e suas conexões.\r\n\r\n    Returns:\r\n        str: Documento final com os placeholders substituídos.\r\n    \"\"\"\r\n    # Gerar os trechos do documento\r\n    doc_nodes_elevations = generate_list_node_with_elevation(nodes)\r\n    doc_pipes = generate_list_pipes(map_pipes)\r\n    doc_nodes_coord = generate_list_node_whit_coord(nodes)\r\n\r\n    # Substituir os placeholders no template\r\n    doc = template.replace(\"{{}}\", doc_nodes_elevations, 1) \\\r\n                  .replace(\"{{}}\", doc_pipes, 1) \\\r\n                  .replace(\"{{}}\", doc_nodes_coord, 1)\r\n\r\n    return doc\r\n\r\nOUT = generate_document(template, nodes, map_pipes)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "13cd07be46ac42c88827766366df4da0",
      "Inputs": [
        {
          "Id": "9455fce7147d4ce4932987ae9507ec89",

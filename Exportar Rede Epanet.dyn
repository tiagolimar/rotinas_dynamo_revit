    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Carregar as bibliotecas DesignScript e padrão do Python\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nimport os\r\n\r\ndef save_to_inp_file(content, filename=\"rede_hidraulica.inp\"):\r\n    \"\"\"\r\n    Salva uma string em um arquivo .inp na pasta Documentos do usuário.\r\n\r\n    Args:\r\n        content (str): O conteúdo a ser salvo no arquivo.\r\n        filename (str): Nome do arquivo (padrão: \"rede_hidraulica.inp\").\r\n\r\n    Returns:\r\n        str: Caminho completo do arquivo salvo.\r\n    \"\"\"\r\n    # Obtém o caminho da pasta Documentos do usuário\r\n    documentos_path = os.path.expanduser(\"~/Documents\")\r\n\r\n    # Caminho completo do arquivo\r\n    file_path = os.path.join(documentos_path, filename)\r\n\r\n    # Escreve a string no arquivo .inp\r\n    with open(file_path, \"w\", encoding=\"utf-8\") as file:\r\n        file.write(content)\r\n\r\n    return file_path  # Retorna o caminho do arquivo salvo\r\n\r\nOUT = save_to_inp_file(IN[0])",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "54fa2ce8488d4f53b785b726e733f3f7",
